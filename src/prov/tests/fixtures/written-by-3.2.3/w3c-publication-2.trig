@prefix ex: <http://example.org/> .
@prefix hg: <http://dvcs.w3.org/hg/prov/raw-file/9628aaff6e20/model/releases/WD-prov-dm-20111215/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rec: <http://example.org/record> .
@prefix w3: <http://www.w3.org/TR/2011/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

{
    w3:WD-prov-dm-20111215 a prov:Entity,
            "html4" ;
        prov:qualifiedDerivation _:Ncd9fe84c4ea34cf4a3d5fee6afe5d539 ;
        prov:qualifiedGeneration rec:g .

    ex:req3 a prov:Entity,
            "http://www.w3.org/2005/08/01-transitions.html#pubreq"^^xsd:anyURI .

    ex:webmaster a prov:Agent,
            prov:Person .

    hg:Overview.html a prov:Entity,
            "file in hg" .

    ex:rcp a prov:Activity,
            "copy directory" ;
        prov:qualifiedUsage rec:u ;
        prov:used ex:req3 ;
        prov:wasAssociatedWith ex:webmaster .

    rec:g a prov:Generation ;
        prov:activity ex:rcp .

    rec:u a prov:Usage ;
        prov:entity hg:Overview.html .

    _:Ncd9fe84c4ea34cf4a3d5fee6afe5d539 a prov:Derivation ;
        prov:entity hg:Overview.html ;
        prov:hadActivity ex:rcp ;
        prov:hadGeneration rec:g ;
        prov:hadUsage rec:u .
}

